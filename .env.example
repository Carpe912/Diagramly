# Browser-visible, non-secret identifiers. Leave base URL empty with a same-origin /rest proxy.
VITE_COOPWIRE_BASE_URL=
VITE_COOPWIRE_PROJECT_ID=
VITE_COOPWIRE_FLOWCHART_ID=
VITE_COOPWIRE_FLOWCHART_TYPE=tobe
# Vite development proxy only. Production should use the host's authenticated reverse proxy.
# COOPWIRE_TARGET=https://your-coopwire.example
# COOPWIRE_SESSION_FILE=/absolute/private/session.json
# Session file format: {"cookie":"..."}; keep outside Git and chmod 600.
